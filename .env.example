# uvicorn은 serve_api.bat / scripts/*.ps1 에서 0.0.0.0 바인딩 → LAN IP·Cloudflare(illammaster.yeobaekstudio.com) 원본 접속 가능. Windows 방화벽에서 포트(기본 8011) 허용.
# PostGIS 포함 PostgreSQL (로컬). 계정·비번·포트·DB명을 본인 환경에 맞출 것 (예: postgres 사용자)
# 스키마: alembic upgrade head (DB에 CREATE EXTENSION postgis 필요)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/illammaster
UPLOAD_ROOT=./data/uploads
DEV_ALLOW_DXF_UPLOAD=true
# ODA_FC_PATH=C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
# 업로드 직후 파싱까지 한 요청에서 끝내기(뷰어 안 뜨는 원인이 백그라운드일 때 시도)
SYNC_COMMIT_PROCESSING=false
